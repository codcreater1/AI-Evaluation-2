{
  "config": {
    "system": "ata-rag",
    "dataset": "demo",
    "evaluators": [
      {"name": "retrieval_recall_at_k", "params": {"k": 3, "min_score": 0.8}},
      "citation_exists",
      "exact_match"
    ],
    "thresholds": {"retrieval_recall_at_k": 0.8}
  },
  "meta": {"app_version": "demo", "model": "demo-model", "prompt_version": "v1"},
  "items": [
    {
      "case": {
        "id": "rag-001", "system": "ata-rag",
        "input": {"question": "How long can an internship last?"},
        "expected_output": {"answer": "up to 6 months", "relevant_doc_ids": ["doc-12", "doc-99"]}
      },
      "execution": {
        "output": {"answer": "Up to 6 months", "citations": ["doc-12"]},
        "retrieved": [{"id": "doc-12", "text": "Internships last up to 6 months."}, {"id": "doc-3"}],
        "latency_ms": 900
      }
    }
  ]
